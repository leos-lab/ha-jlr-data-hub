# Copy to server/.env (never commit it).
# Clients send this as "Authorization: Bearer <API_TOKEN>". Make one with: openssl rand -hex 32
API_TOKEN=
# Password for the bundled Postgres. Make one with: openssl rand -hex 24
POSTGRES_PASSWORD=
# Optional, to use your own Postgres instead of the bundled one: set DATABASE_URL here and remove `db` from compose.yml.
# DATABASE_URL=postgresql://user:password@host:5432/jlr
# Optional: Apple push for alerts to your own iOS app. Mount the folder holding AuthKey_<KEYID>.p8 at /apns.
# APNS_TEAM_ID=
# APNS_TOPIC=
